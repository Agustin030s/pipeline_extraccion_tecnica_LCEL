# Copia este archivo a .env y completa tus claves. Nunca subas .env a git.

# Proveedor a usar: openai | anthropic
LLM_PROVIDER=openai

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Verifica los nombres de modelo vigentes en la documentación oficial:
#   https://platform.openai.com/docs/models
#   https://docs.anthropic.com/en/docs/about-claude/models
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5-5

# Límite de tokens de la respuesta
LLM_MAX_TOKENS=1024
